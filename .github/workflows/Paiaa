name: Build iOS IPA2

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract ZIP
        run: |
          mkdir -p source
          ZIP=$(find . -maxdepth 1 -name "*.zip" -print -quit)
          if [ -n "$ZIP" ]; then
            unzip -oq "$ZIP" -d source
          else
            echo "No ZIP file found"
            exit 1
          fi

      - name: Find Xcode project
        run: |
          PROJECT=$(find source -name "*.xcodeproj" -print -quit)
          WORKSPACE=$(find source -name "*.xcworkspace" -print -quit)

          if [ -n "$WORKSPACE" ]; then
            echo "TYPE=workspace" >> $GITHUB_ENV
            echo "PROJECT_PATH=$WORKSPACE" >> $GITHUB_ENV
          elif [ -n "$PROJECT" ]; then
            echo "TYPE=project" >> $GITHUB_ENV
            echo "PROJECT_PATH=$PROJECT" >> $GITHUB_ENV
          else
            echo "No Xcode project found in ZIP"
            exit 1
          fi

      - name: Build IPA
        run: |
          if [ "$TYPE" = "workspace" ]; then
            OPTION="-workspace"
          else
            OPTION="-project"
          fi

          xcodebuild $OPTION "$PROJECT_PATH" \
            -scheme "$(xcodebuild $OPTION "$PROJECT_PATH" -list | grep -A 5 Schemes | tail -n 1 | xargs)" \
            -sdk iphoneos \
            -configuration Release \
            -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO

          mkdir Payload
          cp -R build/Build/Products/Release-iphoneos/*.app Payload/
          zip -r App.ipa Payload

      - name: Upload IPA
        uses: actions/upload-artifact@v4
        with:
          name: iOS-IPA
          path: App.ipa
